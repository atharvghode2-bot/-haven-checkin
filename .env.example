# Copy to backend/.env and frontend/.env as needed.
# Never commit real secrets.

# Backend (backend/.env or Render Web Service environment variables)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
MONGO_URI=mongodb://localhost:27017
MONGO_DB=haven_checkin
# Set to true to run without MongoDB (in-memory store for demos and quick deployments).
USE_MEMORY_DB=true
HF_API_TOKEN=
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
PORT=8000
CORS_ORIGINS=https://haven-checkin-frontend.onrender.com,http://localhost:5173
SEED_DEMO_DATA=true

# AI Provider Selection: 'ollama' (local) or 'openrouter' / 'groq' / 'hosted' (cloud deployment)
LLM_PROVIDER=ollama

# Local Ollama LLM Runtime (used when LLM_PROVIDER=ollama and no LLM_API_KEY is set)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30.0

# Hosted AI Provider (used when deploying to cloud like Render)
# Free hosted model: OpenRouter free tier (qwen/qwen-2.5-7b-instruct:free)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-7b-instruct:free

# Frontend (frontend/.env or Render Static Site environment variables)
VITE_API_BASE_URL=http://localhost:8000
