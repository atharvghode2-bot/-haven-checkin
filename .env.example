# Copy to backend/.env and frontend/.env as needed.
# Never commit real secrets.

# Backend (backend/.env or Render Web Service environment variables)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
MONGO_URI=mongodb://localhost:27017
MONGO_DB=haven_checkin
# Set to true to run without MongoDB (in-memory store for demos and quick deployments).
USE_MEMORY_DB=true
HF_API_TOKEN=
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
PORT=8000
CORS_ORIGINS=https://haven-checkin-frontend.onrender.com,http://localhost:5173
SEED_DEMO_DATA=true

# AI Provider Selection: 'groq' (production default) or 'ollama' (local development)
AI_PROVIDER=groq

# Hosted Production AI Provider (GroqCloud via OpenAI-compatible endpoint)
# Preferred model: openai/gpt-oss-20b (falls back to llama-3.3-70b-versatile or llama-3.1-8b-instant if not on account)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama LLM Runtime (used when AI_PROVIDER=ollama or no hosted keys are configured)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30.0

# Legacy / alternative hosted AI configuration (OpenRouter or OpenAI)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-7b-instruct:free

# Frontend (frontend/.env or Render Static Site environment variables)
VITE_API_BASE_URL=http://localhost:8000
